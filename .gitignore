# Backend build artifacts and large files
# Rust/Cargo build dirs
backend_event_scraper/target/
backend/**/target/

# Databases and large data files in backend
backend/**/*.sqlite
backend/**/*.sqlite3
backend/**/*.db
backend/**/*.sql

# Archives and other large blobs generated by backend
backend/**/*.tar
backend/**/*.tar.gz
backend/**/*.tgz
backend/**/*.zip

# Ignore any backend node_modules or caches
backend/**/node_modules/
backend/**/.cache/
backend/**/__pycache__/
