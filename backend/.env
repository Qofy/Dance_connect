#  Backend Environment Configuration
# Copy this file to .env and customize for your environment
# .env
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mitote_v026_bike_connect_backend?sslmode=disable
DATABASE_SYNC_ON_OFF=off

# Velophil External Products API URL
PRODUCTS_API_URL=https://velophil.berlin/react-service.php?service=products&generate=1&access_token=VMoxiRv9pyrb6MvwMMYAfNbRiU63QcCnREf4R8FVhAazP3RLDt4AGt79PFsJKhhM

CORS_FILE=.env_cors

# Server Configuration
PORT=8061
HOST=127.0.0.1
SERVER_NAME=mitote_v026_bike_connect_backend_server

# Database Configuration
DB_NAME=mitote_v026_bike_connect_backend_data
DB_PATH=.
# BACKUP_PATH=mitote_v026_bike_connect_backend_data_backup.json


# Periodic Backup Interval (Examples: 5s, 30s, 1m, 5m, 1h)
# s=seconds, m=minutes, h=hours, d=days
# Valid range: 1s to 24h
PERIODIC_BACKUP_DB=900s
PERIODIC_BACKUP_PATH=.
# json for jsona nd .db for sled dumps
# PERIODIC_BACKUP_NAME=mitote_v026_bike_connect_backend_data_backup_{{timestamp}}.json
PERIODIC_BACKUP_NAME=mitote_v026_bike_connect_backend_data_backup_{{timestamp}}.db

# Legacy support (will be converted to "Xs" format)
# BACKUP_INTERVAL_SECONDS=5

# Kitchen IoT Device Connections
KITCHEN_IOT_ENABLED=true
KITCHEN_IOT_URL=http://192.168.1.100:3000
KITCHEN_IOT_TIMEOUT_MS=5000
KITCHEN_IOT_API_KEY=

# Cashier Machine Connections
CASHIER_ENABLED=true
CASHIER_URL=http://192.168.1.101:8061
CASHIER_TIMEOUT_MS=3000
CASHIER_API_KEY=
CASHIER_DEVICE_ID=cashier-001

# Display Connections (for order/menu displays)
DISPLAY_ENABLED=true
DISPLAY_URL=http://192.168.1.102:4000
DISPLAY_TIMEOUT_MS=2000
DISPLAY_API_KEY=
DISPLAY_DEVICE_ID=display-main

# Additional IoT Device Connections
# Format: DEVICE_NAME_URL, DEVICE_NAME_ENABLED, etc.
POS_SYSTEM_ENABLED=false
POS_SYSTEM_URL=http://192.168.1.103:9000
POS_SYSTEM_API_KEY=

INVENTORY_SYSTEM_ENABLED=false
INVENTORY_SYSTEM_URL=http://192.168.1.104:7000
INVENTORY_SYSTEM_API_KEY=

# Logging Configuration
# info debug trace
RUST_LOG=info
LOG_FILE_ENABLED=false
LOG_FILE_PATH=mitote_v026_bike_connect_backend.log
LOG_BODY_SHOW=true
LOG_FORMAT=yaml
# LOG_FORMAT=json
LOG_COLORS=yes
# Comma/newline-separated entries such as "GET /api/health" or "/api/version" to hide matching access logs
# LOG_COLORES=no
LOG_FILE_ENABLED=true
LOG_DEVELOPMENT=true
# Example (multi-line):
LOG_IGNORE_LIST="
/api/health
/api/version
"
# Security Configuration
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
AUTH_TOKEN_EXPIRY_HOURS=24

# Access Token Authentication
ACCESS_TOKEN=your-secure-access-token-here-change-this-in-production

# Development/Debug Settings
DEBUG_MODE=false
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false

TOKEN_ISS=mitote_v026_bike_connect_backendbackend
TOKEN_AUD=mitote_v026_bike_connect_backendfrontend
TOKEN_TTL_SECONDS=4320
PASETO_V4_LOCAL_KEY_HEX=142f46b1b4acb0946e0d9413f29b331db345cf664b9307165eab7531fa32d8bd
